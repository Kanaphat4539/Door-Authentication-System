<mxfile host="app.diagrams.net" modified="2026-10-20T15:15:00.000Z" agent="Antigravity" version="24.7.17" type="device">
  <diagram id="system-overview-clean" name="System Overview Clean">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Classroom Access Management System (กลุ่ม 4)&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal;color:#64748b&quot;&gt;แผนภาพแสดงภาพรวมการทำงานของระบบ (System Overview) — เข้าสู่ระบบ, ตรวจสิทธิ์, ค้นประวัติ, และประมวลผลข้อมูล IoT&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tag" value="GROUP 4 · SYSTEM OVERVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#bfdbfe;fontColor=#1d4ed8;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1480" y="38" width="260" height="36" as="geometry" />
        </mxCell>

        <!-- SECTION 1 PANEL -->
        <mxCell id="sec1_panel" value="ส่วนที่ 1 : การยืนยันตัวตน ตรวจสอบสิทธิ์ (RBAC) และค้นหาประวัติการแตะบัตร" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#1d4ed8;fontStyle=1;fontSize=15;verticalAlign=top;align=left;spacingTop=15;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="1720" height="575" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="actors_box" value="&lt;b&gt;👤 ผู้ใช้งานระบบ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;(Actors เข้าใช้ผ่าน Browser)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#1d4ed8;&quot;&gt;🎓 นักศึกษา (Student)&lt;/b&gt;&lt;br&gt;• ล็อกอินด้วยรหัสนักศึกษา&lt;br&gt;• ดูได้&lt;b style=&quot;color:#dc2626;&quot;&gt;เฉพาะประวัติตัวเอง&lt;/b&gt;&lt;br&gt;(Anti-IDOR บังคับล็อกรหัส)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#6d28d9;&quot;&gt;👨‍🏫 อาจารย์ (Teacher)&lt;/b&gt;&lt;br&gt;• ล็อกอินด้วยบัญชีอาจารย์&lt;br&gt;• &lt;b style=&quot;color:#059669;&quot;&gt;สิทธิ์เต็ม&lt;/b&gt; ค้นหาได้ทุกคน&lt;br&gt;• กรองห้อง, วันที่, ช่วงเวลา&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;ยืนยันตัวตนผ่านบัญชีกลางกลุ่ม 3&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="175" width="235" height="490" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend_box" value="&lt;b&gt;💻 Frontend (Next.js 14)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;ส่วนติดต่อผู้ใช้งาน (Web Browser)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#0369a1;&quot;&gt;1. หน้าเข้าสู่ระบบ (Login View)&lt;/b&gt;&lt;br&gt;• ส่ง Username / Password&lt;br&gt;• รับ JWT Token และ Role&lt;br&gt;• จัดเก็บใน localStorage&lt;br&gt;• แนบ Bearer Token ทุกคำขอ API&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#0369a1;&quot;&gt;2. Dashboard แดชบอร์ดแสดงผล&lt;/b&gt;&lt;br&gt;• ตัวกรอง: รหัส นศ., ห้อง, วันที่, เวลา&lt;br&gt;• สถานะ: ทั้งหมด, IN, OUT, &lt;b style=&quot;color:#059669;&quot;&gt;ACTIVE&lt;/b&gt;&lt;br&gt;(ACTIVE = กำลังใช้ห้อง ล่าสุดเป็น IN)&lt;br&gt;• แสดงตารางประวัติ และแบ่งหน้า&lt;br&gt;• การ์ดสถิติจำนวนคนในห้อง&lt;br&gt;• สลับภาษา ไทย (TH) / อังกฤษ (EN)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#0284c7;font-weight:bold;&quot;&gt;🔒 นศ. ถูกล็อกฟิลด์ค้นหาเฉพาะตัวเอง&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#67e8f9;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="355" y="175" width="320" height="490" as="geometry" />
        </mxCell>

        <!-- Backend Core -->
        <mxCell id="backend_box" value="&lt;b style=&quot;color:#5b21b6;font-size:15px;&quot;&gt;⚙️ FastAPI Backend Core (/api/v1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;พอร์ต 8000 • ประมวลผล, ตรวจสอบสิทธิ์, ป้องกัน IDOR&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#6d28d9;&quot;&gt;3. ระบบยืนยันตัวตน (Authentication Service)&lt;/b&gt;&lt;br&gt;• POST /api/v1/auth/login ตรวจสอบรหัสผ่านกับกลุ่ม 3&lt;br&gt;• สร้าง JWT Token: sub (username), role, exp (120m)&lt;br&gt;• ลงลายมือชื่อดิจิทัล HS256 (JWT_SECRET)&lt;br&gt;• รองรับ /auth/me และ /auth/logout&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#6d28d9;&quot;&gt;4. Logs API &amp; ระบบควบคุมสิทธิ์ (RBAC + Anti-IDOR)&lt;/b&gt;&lt;br&gt;• GET /api/v1/logs ตรวจ JWT และ Signature&lt;br&gt;• อาจารย์: ค้นหาได้ทุกคน ทุกห้อง ไร้ข้อจำกัด&lt;br&gt;• นักศึกษา: บังคับล็อก owner_id = token.sub (Anti-IDOR)&lt;br&gt;• กรองห้อง, วันที่, ช่วงเวลา, สถานะ (IN/OUT/ACTIVE)&lt;br&gt;• ตัดหน้าแบ่งรายการ (Pagination) + สรุปสถิติคนในห้อง&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7c3aed;&quot;&gt;📝 Audit Logging: บันทึกประวัติค้นหาลง user เบื้องหลัง&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.8;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="765" y="175" width="520" height="490" as="geometry" />
        </mxCell>

        <!-- Central Auth Group 3 -->
        <mxCell id="g3_box" value="&lt;b style=&quot;color:#b45309;font-size:15px;&quot;&gt;🏢 Central Auth (กลุ่ม 3)&lt;/b&gt;&lt;br&gt;192.168.100.103:8000/auth/login&lt;br&gt;&lt;br&gt;• ตรวจสอบ Username / Password&lt;br&gt;• ส่งคืน Identity, Role, และชื่อจริง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1385" y="175" width="345" height="155" as="geometry" />
        </mxCell>

        <!-- MariaDB Section 1 -->
        <mxCell id="db_sec1_box" value="&lt;b style=&quot;color:#065f46;font-size:15px;&quot;&gt;🗄️ MariaDB Database (web_app_db)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;🚪 ตาราง web_app (ประวัติแตะบัตร)&lt;/b&gt;&lt;br&gt;• id, timestamp, student_id, room, status (IN/OUT)&lt;br&gt;• รัน id จาก 1 • เวลาจริงประเทศไทย (+07:00)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#334155;&quot;&gt;👤 ตาราง user (Security Audit Trail)&lt;/b&gt;&lt;br&gt;• id, timestamp, username, role, action&lt;br&gt;• บันทึกทุกคำค้นหาเพื่อใช้ตรวจสอบย้อนหลัง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1385" y="355" width="345" height="310" as="geometry" />
        </mxCell>

        <!-- Connectors Section 1 -->
        <mxCell id="c_open" value="เปิดเว็บ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actors_box" target="frontend_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c_login_req" value="POST /login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="270" as="sourcePoint" />
            <mxPoint x="765" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_jwt_res" value="คืนค่า JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="765" y="305" as="sourcePoint" />
            <mxPoint x="675" y="305" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="c_logs_req" value="GET /logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="440" as="sourcePoint" />
            <mxPoint x="765" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_logs_res" value="ส่งประวัติ/สถิติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="765" y="480" as="sourcePoint" />
            <mxPoint x="675" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="c_g3_req" value="ตรวจ Credential" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1285" y="235" as="sourcePoint" />
            <mxPoint x="1385" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_g3_res" value="คืนค่า Role/ชื่อ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1385" y="265" as="sourcePoint" />
            <mxPoint x="1285" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="c_db_read" value="ดึงแตะบัตร" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1285" y="435" as="sourcePoint" />
            <mxPoint x="1385" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_db_audit" value="เขียน Audit Log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1285" y="530" as="sourcePoint" />
            <mxPoint x="1385" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>


        <!-- SECTION 2 PANEL -->
        <mxCell id="sec2_panel" value="ส่วนที่ 2 : ระบบนำเข้าและประมวลผลข้อมูลแตะบัตรจากอุปกรณ์ IoT แบบ Real-time" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#15803d;fontStyle=1;fontSize=15;verticalAlign=top;align=left;spacingTop=15;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="1720" height="420" as="geometry" />
        </mxCell>

        <!-- Hardware Reader -->
        <mxCell id="hw_box" value="&lt;b style=&quot;color:#166534;font-size:15px;&quot;&gt;📟 อุปกรณ์แตะบัตร (Hardware)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;RFID / NFC Scanner ประจำห้องเรียน&lt;/font&gt;&lt;br&gt;&lt;br&gt;• ติดตั้งหน้าห้องเรียน เช่น B316, B317&lt;br&gt;• นักศึกษาแตะบัตรเพื่อ:&lt;br&gt;&amp;nbsp;&amp;nbsp;🟢 เข้าห้องเรียน (IN)&lt;br&gt;&amp;nbsp;&amp;nbsp;🔴 ออกจากห้องเรียน (OUT)&lt;br&gt;• ตรวจจับรหัสบัตรและเวลาแตะบัตร&lt;br&gt;• ส่งข้อมูลขึ้นสู่เซิร์ฟเวอร์ IoT กลุ่ม 6&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#15803d;&quot;&gt;⚡ อัปเดตข้อมูล Real-time&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#86efac;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="775" width="255" height="330" as="geometry" />
        </mxCell>

        <!-- IoT Server Group 6 -->
        <mxCell id="g6_box" value="&lt;b style=&quot;color:#166534;font-size:15px;&quot;&gt;📡 IoT Server (กลุ่ม 6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;http://192.168.100.106:3000&lt;/font&gt;&lt;br&gt;&lt;br&gt;• รวมประวัติการแตะบัตรจากทุกห้องเรียน&lt;br&gt;• ให้บริการ API: GET /api/logs&lt;br&gt;• รองรับ Webhook ส่งข้อมูลทันที&lt;br&gt;• ระบบกลุ่ม 4 ดึงผ่าน Polling ทุก 5 วินาที&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#059669;&quot;&gt;🔗 เชื่อมต่อข้ามเครือข่าย Proxmox&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="395" y="775" width="320" height="330" as="geometry" />
        </mxCell>

        <!-- IoT Sync Service -->
        <mxCell id="sync_box" value="&lt;b style=&quot;color:#5b21b6;font-size:15px;&quot;&gt;🔄 IoT Sync &amp; Cleansing Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;Background Daemon Worker (FastAPI Backend VM4)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Polling Worker: ดึงข้อมูลจากกลุ่ม 6 ทุก 5 วินาที&lt;br&gt;• Data Cleansing: ปรับเวลาเป็นเวลาจริง GMT+7&lt;br&gt;• Deduplication: กรองและตัดรายการซ้ำออก&lt;br&gt;• Name Resolution: แมปรหัสนักศึกษากับชื่อจริง&lt;br&gt;• Local Synced Cache: สำรองข้อมูลกันหลุด&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7c3aed;&quot;&gt;⚡ ส่งข้อมูลเข้า MariaDB web_app อัตโนมัติ&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.8;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="795" y="775" width="490" height="330" as="geometry" />
        </mxCell>

        <!-- MariaDB Destination Section 2 -->
        <mxCell id="db_sec2_box" value="&lt;b style=&quot;color:#065f46;font-size:15px;&quot;&gt;💾 MariaDB (ปลายทางข้อมูล)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;ตาราง web_app พร้อมเสิร์ฟข้อมูลสู่ Dashboard&lt;/font&gt;&lt;br&gt;&lt;br&gt;• ข้อมูลพร้อมใช้งานโดย Dashboard (คนที่ 1-3)&lt;br&gt;• รัน ID ต่อเนื่องจาก 1 ถึงล่าสุด&lt;br&gt;• บันทึกเวลาจริง timestamp (ไม่มี created_at)&lt;br&gt;• คำนวณผู้ที่กำลังใช้งานห้อง (ACTIVE):&lt;br&gt;&amp;nbsp;&amp;nbsp;คนที่มีประวัติล่าสุดในห้องนั้นเป็น IN (ยังไม่ OUT)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#059669;&quot;&gt;🔒 แยกสิทธิ์ดูข้อมูลปลอดภัย ไร้ช่องโหว่ IDOR&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.6;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1385" y="775" width="345" height="330" as="geometry" />
        </mxCell>

        <!-- Connectors Section 2 -->
        <mxCell id="c_hw_g6" value="ส่งข้อมูล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hw_box" target="g6_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c_g6_sync" value="ดึง / รับ Log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="715" y="915" as="sourcePoint" />
            <mxPoint x="795" y="915" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_g6_sync_res" value="ส่ง Raw Log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="795" y="955" as="sourcePoint" />
            <mxPoint x="715" y="955" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="c_sync_db" value="บันทึก web_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sync_box" target="db_sec2_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
