  <diagram id="system-overview" name="System Overview">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="panel-main" value="1 · เข้าสู่ระบบและค้นประวัติ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dce4ef;fontColor=#33445e;fontStyle=1;verticalAlign=top;spacingTop=18;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1720" height="625" as="geometry"/></mxCell>
        <mxCell id="panel-iot" value="2 · รับและจัดเก็บข้อมูลจากอุปกรณ์ IoT" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dce4ef;fontColor=#33445e;fontStyle=1;verticalAlign=top;spacingTop=18;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1720" height="350" as="geometry"/></mxCell>
        <mxCell id="backend-frame" value="FASTAPI BACKEND · /api/v1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f7f4ff;strokeColor=#b5a5ef;fontColor=#5a43a4;fontStyle=1;verticalAlign=top;spacingTop=18;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="690" y="198" width="625" height="910" as="geometry"/></mxCell>
        <mxCell id="title" value="Classroom Access Management System&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal;color:#52627a&quot;&gt;ภาพรวมการทำงาน · ระบบดูประวัติการเข้า–ออกห้องเรียนของนักศึกษา&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#17243a;" vertex="1" parent="1"><mxGeometry x="54" y="24" width="1200" height="105" as="geometry"/></mxCell>
        <mxCell id="tag" value="GROUP 4 · SYSTEM OVERVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9efff;strokeColor=none;fontColor=#3554b5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1474" y="40" width="270" height="38" as="geometry"/></mxCell>
        <mxCell id="actors" value="ผู้ใช้งาน&lt;br&gt;&lt;br&gt;🔵 นักศึกษา&lt;br&gt;&lt;br&gt;🟣 อาจารย์&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#586780&quot;&gt;เข้าสู่ระบบด้วยบัญชีกลาง&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f1f5ff;strokeColor=#b7c7ef;fontColor=#17243a;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="350" width="205" height="270" as="geometry"/></mxCell>
        <mxCell id="frontend" value="เว็บแอป · Next.js&lt;br&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;color:#52627a&quot;&gt;หน้าจอที่ผู้ใช้โต้ตอบ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;หน้าเข้าสู่ระบบ&lt;/b&gt;&lt;br&gt;ส่ง username / password&lt;br&gt;รับ JWT แล้วแนบ Bearer Token&lt;br&gt;&lt;br&gt;&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;ตัวกรอง · ตารางประวัติ · สถิติ&lt;br&gt;รหัส / ห้อง / วันที่ / เวลา / สถานะ&lt;br&gt;แบ่งหน้าและรีเฟรชข้อมูล&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#586780&quot;&gt;นักศึกษาเห็นรหัสของตนเองแบบล็อกไว้&lt;br&gt;ออกจากระบบ: ล้าง token ฝั่ง browser&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#8eb9f7;fontColor=#17243a;fontSize=16;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="330" height="430" as="geometry"/></mxCell>
        <mxCell id="auth" value="3 · ยืนยันตัวตน&lt;br&gt;&lt;br&gt;POST /api/v1/auth/login&lt;br&gt;ตรวจผลบัญชีกลางและ role&lt;br&gt;ออก JWT (username, role, exp)&lt;br&gt;&lt;br&gt;ไม่ผ่าน → 401&lt;br&gt;/auth/me · /auth/logout" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3c8f4;fontColor=#17243a;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="720" y="265" width="260" height="180" as="geometry"/></mxCell>
        <mxCell id="logs" value="4 · Logs API + RBAC&lt;br&gt;&lt;br&gt;GET /api/v1/logs&lt;br&gt;ตรวจ JWT ก่อนอ่านข้อมูล&lt;br&gt;&lt;br&gt;&lt;b&gt;อาจารย์&lt;/b&gt; — ค้นได้ทุกคนและทุกห้อง&lt;br&gt;&lt;b&gt;นักศึกษา&lt;/b&gt; — owner จาก JWT, เห็นเฉพาะตนเอง&lt;br&gt;&lt;br&gt;ตัวกรอง: รหัส · ห้อง · วันที่ · เวลา · สถานะ&lt;br&gt;คืน logs · สถิติ · pagination&lt;br&gt;บันทึกการค้นหา/กรองลง audit log" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3c8f4;fontColor=#17243a;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1000" y="265" width="285" height="382" as="geometry"/></mxCell>
        <mxCell id="group3" value="G3 · Central Auth&lt;br&gt;&lt;br&gt;ตรวจ username / password&lt;br&gt;ส่งคืน identity และ role&lt;br&gt;&lt;br&gt;กลุ่ม 3 · /auth/login" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#e9c78e;fontColor=#17243a;fontSize=16;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="1395" y="245" width="310" height="165" as="geometry"/></mxCell>
        <mxCell id="db" value="MariaDB · web_app_db&lt;br&gt;&lt;br&gt;&lt;b&gt;web_app&lt;/b&gt;&lt;br&gt;ประวัติแตะบัตร · IN / OUT&lt;br&gt;&lt;br&gt;&lt;b&gt;user&lt;/b&gt;&lt;br&gt;Audit log · ผู้ใช้ / role / action" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ecfbf7;strokeColor=#83cbb5;fontColor=#17243a;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1395" y="485" width="310" height="235" as="geometry"/></mxCell>
        <mxCell id="iot-api" value="5 · IoT Sync / Ingestion&lt;br&gt;&lt;br&gt;/iot/sync · /iot/webhook&lt;br&gt;ดึง/รับ → ตรวจ → deduplicate&lt;br&gt;→ บันทึก access logs&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#586780&quot;&gt;sync เมื่อเริ่มระบบ · poll เมื่อเปิดใช้ตามรอบ&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3c8f4;fontColor=#17243a;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="715" y="855" width="270" height="185" as="geometry"/></mxCell>
        <mxCell id="cache" value="Local synced cache&lt;br&gt;&lt;br&gt;สำรองรายการที่ sync แล้ว&lt;br&gt;ในไฟล์ local cache" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f4f6f9;strokeColor=#c6cfdb;fontColor=#17243a;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="885" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="group6" value="G6 · IoT Server&lt;br&gt;&lt;br&gt;ข้อมูลแตะบัตรเข้า–ออกห้อง&lt;br&gt;GET /api/logs · กลุ่ม 6&lt;br&gt;&lt;br&gt;รองรับ webhook ด้วย" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#8bc9a4;fontColor=#17243a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="1395" y="865" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="iot-source" value="แหล่งข้อมูล&lt;br&gt;&lt;br&gt;เครื่องอ่านบัตรส่งรายการ&lt;br&gt;เข้า / ออก พร้อมรหัสผู้ใช้&lt;br&gt;&lt;br&gt;ตรวจข้อมูลและกันรายการซ้ำ" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#8bc9a4;fontColor=#17243a;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="875" width="285" height="150" as="geometry"/></mxCell>
        <mxCell id="legend" value="เส้นทึบสีน้ำเงิน: คำขอ API · เส้นประ: ผลตอบกลับ / token · เส้นสีเขียว: access log" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#586780;" vertex="1" parent="1"><mxGeometry x="65" y="1070" width="700" height="30" as="geometry"/></mxCell>

        <mxCell id="e-user" value="เปิดเว็บ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="actors" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-login" value="POST /auth/login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="frontend" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-jwt" value="JWT + role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="auth" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-auth-request" value="ตรวจ credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52627a;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="auth" target="group3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-auth-response" value="identity + role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="group3" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-query" value="GET /logs + Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="frontend" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-response" value="logs + stats + pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="logs" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-read-db" value="อ่าน access logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#18865d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="logs" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-audit-db" value="เขียน audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52627a;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="logs" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-poll" value="poll GET /api/logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52627a;strokeWidth=2;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="iot-api" target="group6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ingest-db" value="ตรวจแล้ว → web_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#18865d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="iot-api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cache" value="cache / fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52627a;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="iot-api" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-manual-sync" value="manual sync / refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d63dd;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#52627a;" edge="1" parent="1" source="frontend" target="iot-api"><mxGeometry relative="1" as="geometry"/></mxCell>
