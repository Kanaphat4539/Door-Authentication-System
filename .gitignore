# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets & credentials (never commit)
*SECRET*.md
*PRIVATE*.md
*secret*
*private*

# Real CE04 roster and local review notes must not be pushed with public source.
/data/private/
!.env.example

__pycache__/
*.pyc

# Local agent instructions and tooling (not part of the application)
AGENTS.md
**/AGENTS.md
/.agents/
/.codex/

# Local handover exports and confidential backups
/outputs/
*.PRIVATE.*
*.SECRET.*
*.dump
