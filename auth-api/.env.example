# Default: use the real RADIUS adapter. Missing RADIUS values make login return 503.
AUTH_MODE=radius

# Obtain these from the RADIUS team; do not commit the actual shared secret.
RADIUS_HOST=
RADIUS_PORT=1812
RADIUS_SECRET=
RADIUS_TIMEOUT=3
RADIUS_ATTEMPTS=2
RADIUS_NAS_IDENTIFIER=auth-api

# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET and RADIUS_SECRET are different secrets.
JWT_SECRET=
JWT_ISSUER=auth-api
JWT_AUDIENCE=door-system
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Development only: explicitly set AUTH_MODE=mock and fill BOTH values.
MOCK_USERNAME=
MOCK_PASSWORD=
