# Run portal on the VM: 127.0.0.1. Local development: open the SSH tunnel first.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cedatabase
DB_USER=portal_app
DB_PASSWORD=
ADMIN_USERNAME=ceadmin
# Separate portal administrator password, at least 12 characters (not a student password).
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Browser-visible URL, no trailing slash. Local example below; on VM use its actual portal URL.
APP_ORIGIN=http://localhost:3000
# University LAN HTTP only. Set true if HTTPS is enabled.
COOKIE_SECURE=false
