# Local portal: open the SSH tunnel to the existing university PostgreSQL VM first.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cedatabase
DB_USER=ceadmin
DB_PASSWORD=
ADMIN_USERNAME=portaladmin
# Separate portal administrator password, at least 12 characters (not a student password).
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Browser-visible URL, no trailing slash. Use the same URL on every client.
APP_ORIGIN=http://localhost:3000
# University LAN HTTP only. Set true if HTTPS is enabled.
COOKIE_SECURE=false
